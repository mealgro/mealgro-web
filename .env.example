# Public settings for the web build (read in the browser; nothing here is secret).
# Vike exposes anything named PUBLIC_ENV__*. Set them where `npm run build` runs
# (the Firebase Hosting workflow reads them from the repository's Actions
# variables). A blank value leaves that feature off.

# Sign in with Google on the vendor portal (/account/login): the OAuth *web*
# client ID from Google Cloud > APIs & Services > Credentials. The API has to
# list the same ID in its GOOGLE_CLIENT_ID. Blank: no Google button.
PUBLIC_ENV__GOOGLE_CLIENT_ID=

# Sign in with Apple on the vendor portal: the Services ID (it is
# app.mealgro.mobile.signin, the one the Android app signs in under). Blank: no
# Apple button.
PUBLIC_ENV__APPLE_CLIENT_ID=

# Where Apple returns after sign-in: a Return URL listed on that Services ID.
# Optional; the sign-in page itself (https://mealgro.com/account/login) if blank.
PUBLIC_ENV__APPLE_REDIRECT_URI=
